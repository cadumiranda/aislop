<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>AutonomiaSaaS.Modules.RiskGate</RootNamespace>
    <!-- Necessário para um módulo com Controllers MVC além de Razor Views
         "soltas" — sem isso, o roteamento de Controllers deste módulo não
         é descoberto pelo host. Padrão usual de módulo Orchard Core com
         Admin UI. -->
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
  </PropertyGroup>

	<!--
    Igual à nota no módulo de Sandbox: não fixe aqui a versão de pacotes OrchardCore.* que o
    host (AutonomiaSaaS.Web) já resolve — isso já causou conflito real de versão do YesSql
    (spec v2.0, seção 8.3). Este OrchardCore.BackgroundTasks é só para este pacote isolado
    compilar sozinho nesta entrega; ao colar dentro do projeto RiskGate real, remova esta
    PackageReference e deixe vir transitivamente do host, como os outros módulos já fazem.
  -->
	

  <ItemGroup>
    <!-- ⚠️ MAIOR RISCO DE COMPILAÇÃO DESTE MÓDULO: OrchardCore.Module.Targets
         é o pacote que traz o MSBuild targets responsável por empacotar
         Controllers/Views/Manifest.cs como um módulo Orchard Core de verdade
         (em vez de só uma class library com um assembly attribute). Escrevi
         isso com base no padrão usual de projeto de módulo do Orchard Core,
         mas não tenho como confirmar a versão exata nem se o nome do pacote
         mudou em versões recentes sem acesso ao NuGet. -->
    <PackageReference Include="OrchardCore.Module.Targets" Version="3.0.1" />
    <PackageReference Include="OrchardCore.Admin" Version="3.0.1" />
    <PackageReference Include="OrchardCore.Navigation" Version="3.0.1" />
	<PackageReference Include="OrchardCore.BackgroundTasks" Version="3.0.1" />
	<PackageReference Include="OrchardCore.Notifications" Version="3.0.1" />
	<PackageReference Include="OrchardCore.Users" Version="3.0.1" />
    <PackageReference Include="Elsa.Workflows.Core" Version="3.7.1" />
	<PackageReference Include="Microsoft.Extensions.Identity.Stores" Version="8.0.0" />
	  <!-- [NOVO] Integração com Audit Trail. -->
	  <PackageReference Include="OrchardCore.AuditTrail" Version="3.0.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- RiskGate depende de BusinessCore (IAgentTaskStore, IBusinessContextStore,
         a máquina de estados e RiskLevel) — dependência de mão única, conforme
         planejado desde o módulo anterior. Não depende de AgentRuntime: a
         classificação de risco não precisa saber como uma chamada de modelo
         é feita. -->
    <ProjectReference Include="..\AutonomiaSaaS.Modules.BusinessCore\AutonomiaSaaS.Modules.BusinessCore.csproj" />
  </ItemGroup>

</Project>
