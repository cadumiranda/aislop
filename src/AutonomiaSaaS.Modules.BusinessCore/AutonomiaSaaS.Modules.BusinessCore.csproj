<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>AutonomiaSaaS.Modules.BusinessCore</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Versão do Orchard Core não fixada aqui de propósito — usar a mesma
         versão do host AutonomiaSaaS.Web (gerenciada centralmente, idealmente
         via Directory.Packages.props quando o host existir). Ajuste a versão
         abaixo para a que estiver no seu AutonomiaSaaS.Web.csproj. -->
    <PackageReference Include="OrchardCore.ContentManagement" Version="3.0.1" />
    <PackageReference Include="OrchardCore.Data" Version="3.0.1" />
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="3.53.3" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.1.1" />
    <!-- Removido referência explícita a YesSql.Abstractions para evitar conflitos
         de versão com dependências transitivas do Orchard Core. O pacote
         correto será resolvido pela dependência OrchardCore.Data.Abstractions. -->
  </ItemGroup>

  <!-- BusinessCore não referencia AgentRuntime nem nenhum outro módulo de
       agente: Content Types e a máquina de estados da tarefa não precisam
       saber como uma chamada de modelo é feita. Isso mantém a dependência
       de mão única correta: AcquisitionAgent (futuro) vai depender de
       BusinessCore e de AgentRuntime, nunca o contrário. -->

</Project>
