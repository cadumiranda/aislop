<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>AutonomiaSaaS.Modules.AcquisitionAgent</RootNamespace>
    <!-- Mudou de Sdk="Microsoft.NET.Sdk" para Sdk="Microsoft.NET.Sdk.Razor"
         + AddRazorSupportForMvc ao ganhar LandingPageController e as Views
         de Index/Result — mesmo padrão e mesmo aviso de risco do módulo
         RiskGate (ver README, seção "Painel de Aprovação"). -->
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="OrchardCore.Module.Targets" Version="3.0.1" />
    <PackageReference Include="OrchardCore.Navigation" Version="3.0.1" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <!-- Único módulo que depende dos três anteriores ao mesmo tempo — é
         exatamente por isso que ele foi implementado por último, seguindo a
         ordem de menor para maior dependência que vimos usando desde o
         início (AgentRuntime -> BusinessCore -> RiskGate -> AcquisitionAgent). -->
    <ProjectReference Include="..\AutonomiaSaaS.Modules.AgentRuntime\AutonomiaSaaS.Modules.AgentRuntime.csproj" />
    <ProjectReference Include="..\AutonomiaSaaS.Modules.BusinessCore\AutonomiaSaaS.Modules.BusinessCore.csproj" />
    <ProjectReference Include="..\AutonomiaSaaS.Modules.CredentialVault\AutonomiaSaaS.Modules.CredentialVault.csproj" />
    <ProjectReference Include="..\AutonomiaSaaS.Modules.RiskGate\AutonomiaSaaS.Modules.RiskGate.csproj" />
  </ItemGroup>

</Project>
