{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Default": "Information",
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "theme": "Serilog.Sinks.SystemConsole.Themes.AnsiConsoleTheme::Code, Serilog.Sinks.Console",
          "outputTemplate": "{Timestamp:HH:mm:ss}|{TenantName}|{RequestId}|{SourceContext}|{Level:u3}|{Message:lj}{NewLine}{Exception}",
          "restrictedToMinimumLevel": "Information"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "App_Data/logs/orchard-log.txt",
          "rollingInterval": "Day",
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.ffff}|{TenantName}|{RequestId}|{SourceContext}|{Level:u3}|{Message:lj}{NewLine}{Exception}",
          "restrictedToMinimumLevel": "Warning"
        }
      }
    ]
  },
  "AllowedHosts": "*",

  "OrchardCore": {
    "OrchardCore_Shells": {
      "DefaultTenant": {
        "State": "Uninitialized"
      }
    }
  },

  "AgentRuntime": {
    "BaseUrl": "https://api.anthropic.com",
    "ApiVersion": "2023-06-01",
    "PlanningModel": "claude-sonnet-5",
    "RepetitiveModel": "claude-haiku-4-5-20251001",
    "TimeoutSeconds": 60

    // ApiKey NÃO fica aqui de propósito. Em desenvolvimento local, defina via
    // .NET User Secrets:
    //   dotnet user-secrets set "AgentRuntime:ApiKey" "sk-ant-..."
    // Em produção, via variável de ambiente AGENTRUNTIME__APIKEY ou,
    // idealmente, Azure Key Vault (ver seção 7 da especificação técnica).
  }
}
