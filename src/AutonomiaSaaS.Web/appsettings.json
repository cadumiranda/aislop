{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Default": "Information",
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "theme": "Serilog.Sinks.SystemConsole.Themes.AnsiConsoleTheme::Code, Serilog.Sinks.Console",
          "outputTemplate": "{Timestamp:HH:mm:ss}|{TenantName}|{RequestId}|{SourceContext}|{Level:u3}|{Message:lj}{NewLine}{Exception}",
          "restrictedToMinimumLevel": "Information"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "App_Data/logs/orchard-log.txt",
          "rollingInterval": "Day",
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.ffff}|{TenantName}|{RequestId}|{SourceContext}|{Level:u3}|{Message:lj}{NewLine}{Exception}",
          "restrictedToMinimumLevel": "Warning"
        }
      }
    ]
  },
  "AllowedHosts": "*",
  "OrchardCore": {
    "OrchardCore_Shells": {
      "DefaultTenant": {
        "State": "Uninitialized"
      }
    }
  },
  "AgentRuntime": {
    "BaseUrl": "https://api.anthropic.com",
    "ApiVersion": "2023-06-01",
    "PlanningModel": "claude-sonnet-5",
    "RepetitiveModel": "claude-haiku-4-5-20251001",
    "TimeoutSeconds": 60
  },
  "Vercel": {
    "UseFake": true,
    "ApiToken": "",
    "BaseUrl": "https://api.vercel.com",
    "TeamId": null,
    "HealthCheckTimeout": "00:03:00",
    "HealthCheckPollingInterval": "00:00:03",
    "CredentialKey": "vercel_deploy_token",
    "CredentialAgentName": "acquisition_agent"
  }
}
