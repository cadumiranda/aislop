<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
	<ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
	<RootNamespace>AutonomiaSaaS.Modules.CredentialVault</RootNamespace>
	<!-- Mudou de Sdk="Microsoft.NET.Sdk" para Sdk="Microsoft.NET.Sdk.Razor"
         + AddRazorSupportForMvc ao ganhar LandingPageController e as Views
         de Index/Result — mesmo padrão e mesmo aviso de risco do módulo
         RiskGate (ver README, seção "Painel de Aprovação"). -->
	<AddRazorSupportForMvc>true</AddRazorSupportForMvc>
  </PropertyGroup>

  <!--
    Mesma nota dos módulos anteriores: não fixar versão de pacotes OrchardCore.*/YesSql aqui
    além do necessário para este pacote compilar isolado. Ao colar na solução real, prefira
    deixar a versão vir transitivamente do host, como os demais módulos já fazem.
  -->
  <ItemGroup>
	<PackageReference Include="OrchardCore.Module.Targets" Version="3.0.1" />
    <PackageReference Include="Microsoft.AspNetCore.DataProtection.Abstractions" Version="8.0.0" />
	<PackageReference Include="OrchardCore.Admin" Version="3.0.1" />
	<PackageReference Include="OrchardCore.Data" Version="3.0.1" />
	<PackageReference Include="OrchardCore.Navigation" Version="3.0.1" />
	<PackageReference Include="OrchardCore.Security" Version="3.0.1" />
	  <!-- [NOVO] Integração com Audit Trail. -->
	  <PackageReference Include="OrchardCore.AuditTrail" Version="3.0.1" />
    <PackageReference Include="YesSql.Abstractions" Version="5.4.7" />
  </ItemGroup>

</Project>
