<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!--
    Sem <PackageReference> de OrchardCore.* fixando versão aqui de propósito — mesma lição real
    registrada na spec v2.0, seção 8.3 (conflito de YesSql causado por fixar versão num módulo que
    não referencia o pacote guarda-chuva). Deixe a versão vir transitivamente do host
    (AutonomiaSaaS.Web) via referência de projeto, igual aos outros módulos.
    Ajuste isto para o formato real de PackageReference usado no restante da solução.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.FileSystemGlobbing" Version="8.0.0" />
    <PackageReference Include="OrchardCore.Module.Targets" Version="3.0.1" />
    <PackageReference Include="RabbitMQ.Client" Version="7.2.2" />
  </ItemGroup>

</Project>
