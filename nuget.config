<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
	<!-- Mantém nuget.org e o feed de preview do Orchard Core para pacotes que não estão no feed público -->
	<clear />
	<add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
<!-- Caso o feed precise de autenticação, usuário deve configurar as credenciais locais (nuget sources add -n OrchardCorePreview -u <user> -p <key>) -->
  </packageSources>
</configuration>
